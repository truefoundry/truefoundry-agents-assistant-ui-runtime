{
  "name": "@truefoundry/agent-server-adapter",
  "version": "0.1.0",
  "description": "Adapts truefoundry-gateway-sdk AgentSessionClient into AgentChatServer for @truefoundry/assistant-ui-runtime",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@truefoundry/assistant-ui-runtime": "workspace:^",
    "truefoundry-gateway-sdk": "^0.4.0-rc.5"
  },
  "devDependencies": {
    "@truefoundry/assistant-ui-runtime": "workspace:*",
    "truefoundry-gateway-sdk": "0.4.0-rc.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
